# Supabase — values from Project Settings → API / Connect panel.
# Do not commit real secrets. Use `.env.local` for local development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional canonical site URL for OAuth redirectTo (no trailing slash).
# Production: https://hui-seven-gamma.vercel.app
# NEXT_PUBLIC_APP_URL=

# Server-only secret key (never prefix with NEXT_PUBLIC_):
# SUPABASE_SECRET_KEY=

# Web Push (HUI-023). Generate a VAPID key pair locally; do not commit the private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Optional bearer secret for the drain route and Vercel Cron. Either name works.
# PUSH_DELIVERY_SECRET=
# CRON_SECRET=

# Maps (all optional). Defaults to the OpenFreeMap public instance: no key, commercial use allowed, no SLA.
# Set NEXT_PUBLIC_MAP_ENABLED=false to turn maps off (events then show the address only).
# NEXT_PUBLIC_MAP_ENABLED=true
# NEXT_PUBLIC_MAP_PROVIDER=openfreemap
# For a paid or self-hosted provider: NEXT_PUBLIC_MAP_PROVIDER=custom and MapLibre style JSON URLs.
# NEXT_PUBLIC_MAP_STYLE_LIGHT_URL=
# NEXT_PUBLIC_MAP_STYLE_DARK_URL=
# NEXT_PUBLIC_MAP_API_KEY=